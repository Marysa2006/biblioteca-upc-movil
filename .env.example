# Copia este archivo como .env y ajusta los valores. El .env no se sube al repositorio.

# URL base de la API del Backend (cuando exista). Desde el celular, usa la IP del computador, no localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api

# true: la app usa datos de prueba (src/api/mocks). false: llama a la API real.
EXPO_PUBLIC_USAR_MOCKS=true
