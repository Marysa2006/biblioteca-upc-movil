{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USAR_MOCKS": "true"
      }
    },
    "integracion": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USAR_MOCKS": "true",
        "EXPO_PUBLIC_API_URL": "https://backend-biblioteca-njx5.onrender.com/api/v1",
        "EXPO_PUBLIC_API_MODULOS": "sesion,servicios,contenidos,recursos,guias,notificaciones,parametros,fotosInicio,espacios,asesorias,capacitaciones,tablets,solicitudes,reservas,bloqueos,usuarios,estadisticas"
      }
    }
  }
}
