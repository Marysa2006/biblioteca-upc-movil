# Copia este archivo como .env y ajusta los valores. El .env no se sube al repositorio.

# URL base de la API del Backend, con el prefijo /api/v1. El servidor de pruebas está en Render;
# la primera llamada puede tardar hasta un minuto si estaba dormido.
# En un APK solo funciona HTTPS: el APK no permite tráfico http (#299).
# Con un servidor local por http (por ejemplo http://192.168.1.10:8000/api/v1, con la IP del
# computador y no localhost), prueba en Expo Go, o usa un túnel HTTPS para el APK.
EXPO_PUBLIC_API_URL=https://backend-biblioteca-njx5.onrender.com/api/v1

# true: la app usa datos de prueba (src/api/mocks), salvo los módulos de EXPO_PUBLIC_API_MODULOS.
# false: toda la app llama a la API real.
EXPO_PUBLIC_USAR_MOCKS=true

# Módulos que ya usan la API aunque USAR_MOCKS sea true, separados por comas. Así se conecta la app
# de a poco (ver docs/integracion-backend.md). Vacío: todo con datos de prueba.
# Conectados hasta ahora: sesion, servicios, contenidos, recursos, guias, notificaciones, parametros y
# fotosInicio; en la fase 3, espacios, asesorias, capacitaciones, tablets y solicitudes (ver docs/integracion-backend.md, §4).
EXPO_PUBLIC_API_MODULOS=
